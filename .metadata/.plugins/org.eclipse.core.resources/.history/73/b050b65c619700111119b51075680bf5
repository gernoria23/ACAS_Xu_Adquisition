/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_GPDMA1_Init();
  MX_USART1_UART_Init();
  MX_USART2_UART_Init();
  SystemIsolation_Config();
  /* USER CODE BEGIN 2 */

  uint8_t *dmaStartAddress = ADSB_GetRGBUFF_Address();
  uint16_t dmaBuffZize = ADSB_GetRGBUFF_Size();
  if (HAL_UART_Receive_DMA(&huart2, dmaStartAddress, dmaBuffZize) == HAL_OK) ADSB_RingBuffers_Init();

  ADSB_RingBuffer_Init(&ADSB_ReceiveBuff, dmaStartAddress, dmaBuffZize);

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */

  uint8_t SystemState = 0;
  uint16_t Heading = 0;

  while (1)
  {

	  if (adsbflagStatus != ADSB_EMPTY)
	  {
		  ADSB_Read_HalfBuffer(&ADSB_ReceiveBuff, HAL_GetTick());
		  adsbflagStatus = ADSB_GetFlagStatus();
		  StartParsingFlag = 1;
	  }else
	  {
		  ADSB_FrameStruct tempFrame = ADSB_Read_DownlinkFormatBuffer(18);

		  if (tempFrame.Status == VALID_FRAME)
		  {
			  if (tempFrame.TypeCode == 23)
			  {
				  SystemState = (tempFrame.Message >>  48) & 0x03;
				  Heading = (tempFrame.Messge >> 33) & 0x0FFF;

			  }
		  }

	  }


    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

