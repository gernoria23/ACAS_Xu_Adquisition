 *
 * ****************************************************************************************************************************************************************************/

ADSB_FrameStruct ADSB_RingBuffer_PopFrame(Frame_RGBuffer_t *RingBuffer)
{
	ADSB_FrameStruct tempFrame = {0};
	if(RingBuffer->head == (RingBuffer->tail))
	{
		tempFrame.Status = EMPTY_FRAME;
		return tempFrame;
	}
	tempFrame = RingBuffer->buffer[RingBuffer->tail];
	RingBuffer->tail = (RingBuffer->tail + 1) % RingBuffer->capacity;

	tempFrame.Status = VALID_FRAME;
	return tempFrame;
}

/******************************************************************************************************************************************************************************
 * @fn					- ADSB_RingBuffer_PushCPRFrame
 *
 * @brief				- This function push a new CPR frame into the Ring Buffer Selected
 *
 * @param[*RingBuffer]	- Pointer to the Ring Buffer Handler
 * @param[CPR_Data]		- CPR Frame to add to the Ring buffer
 *
 * @Note				- none
 *
 * ****************************************************************************************************************************************************************************/

void ADSB_RingBuffer_PushCPRFrame(ADSB_RngBuff_CPR *RingBuffer, ADSB_LocationByICAO CPR_Data)
{
	RingBuffer->buffer[RingBuffer->head] = CPR_Data;
	RingBuffer->head= (RingBuffer->head + 1) % RingBuffer->capacity;
	RingBuffer->count ++;
	if(RingBuffer->head == RingBuffer->tail)
	{
		RingBuffer->tail = (RingBuffer->tail + 1) % RingBuffer->capacity;
	}
}

/******************************************************************************************************************************************************************************
 * @fn					- ADSB_RingBuffer_PopCPRFrame
 *
 * @brief				- This function pop and return the oldest Frame in the Ring Buffer
 *
 * @param[*RingBuffer]	- Pointer to the CPR Ring Buffer Handler Selected
 *
 * @Note				- none
 *
 * ****************************************************************************************************************************************************************************/

ADSB_LocationByICAO ADSB_RingBuffer_PopCPRFrame(ADSB_RngBuff_CPR *RingBuffer)
{
	ADSB_LocationByICAO CPR_Data = {0};
	if(RingBuffer->head == (RingBuffer->tail))
	{
		RingBuffer->status = RGBFF_NOT_READY;
		return CPR_Data;
	}
	CPR_Data = RingBuffer->buffer[RingBuffer->tail];
	RingBuffer->tail = (RingBuffer->tail + 1) % RingBuffer->capacity;

	RingBuffer->status = RGBFF_READY;
	return CPR_Data;
}

/******************************************************************************************************************************************************************************
 * @fn					- ADSB_FindValidFrame
 *
 * @brief				- This functions read the ADSB Ring Buffer looking for a valid Frame in it.
 * 						  Returns a Frame Status depending on what it finds
 *
 * @Note				-
 *
 ******************************************************************************************************************************************************************************/

ADSB_FrameStatus ADSB_FindValidFrame(ADSB_RGBuffer_t * pRingBuff)
{
	ADSB_FrameStatus validFrameFlg = EMPTY_FRAME ;

	while(validFrameFlg != VALID_FRAME && ADSB_KeepLooking())
	{
		while (pRingBuff->buffer[pRingBuff->index] != '*' /*&&  ADSB_KeepLooking()*/) ADSB_MovFwd(pRingBuff);

		ADSB_MovFwd(pRingBuff);

		uint32_t temp_index = pRingBuff->index;

		while (pRingBuff->buffer[pRingBuff->index] != ';' /* && ADSB_KeepLooking()*/)
		{
			if ((pRingBuff->index - temp_index) > FRAME_SZ+1)
			{
				validFrameFlg = FRAME_OUT_OF_RANGE;
				return validFrameFlg;
			}
			ADSB_MovFwd(pRingBuff);
		}

		if((pRingBuff->index - temp_index) != FRAME_SZ)
		{
			validFrameFlg = INVALID_LENGHT;
			return validFrameFlg;
		}else
		{
			pRingBuff->index = temp_index;
			uint16_t temp_DF = (ascii_to_hex(pRingBuff->buffer[pRingBuff->index])) << 4 ;
			ADSB_MovFwd(pRingBuff);
			temp_DF |= ascii_to_hex(pRingBuff->buffer[pRingBuff->index]);
			temp_DF = temp_DF >> 3;
			if (ADSB_validateDF(temp_DF))
			{
				pRingBuff->index = temp_index;
				validFrameFlg = VALID_FRAME;
			}
		}
	}

	return validFrameFlg;
}
/******************************************************************************************************************************************************************************
 * @fn					- ADSB_Get_Instant_DF
 *
 * @brief				- This function returns the Downlink Format that is in the actual index of the ADSB Ring Buffer, and then pass to the index of next section of the frame.
 *
 * @Note				- none
 *
 ******************************************************************************************************************************************************************************/
uint8_t ADSB_Get_Instant_DF(uint8_t* pBuff)
{
	uint8_t tempData = (ascii_to_hex(*pBuff)) << 4;
	pBuff++;
	tempData |=  ascii_to_hex(*pBuff);
	tempData = tempData >> 3;
	return tempData;
}

/******************************************************************************************************************************************************************************
 * @fn					- ADSB_Get_Instant_CA
 *
 * @brief				- This function returns the Capability that is in the actual index of the ADSB Ring Buffer, and then pass to the index of next section of the frame.
 *
 * @Note				- none
 *
 *****************************************************************************************************************************************************************************/
uint8_t ADSB_Get_Instant_CA(uint8_t* pBuff)
{
	uint8_t tempData = ascii_to_hex(*pBuff);
	tempData &= ~(1 << 3);
	return tempData;
}

/******************************************************************************************************************************************************************************
 * @fn					- ADSB_Get_Instant_ICAOAdd
 *
 * @brief				- This function returns the ICAO Address that is in the actual index of the ADSB Ring Buffer, and then pass to the index of next section of the frame.
 *
 * @Note				- none
 *
 ******************************************************************************************************************************************************************************/
uint32_t ADSB_Get_Instant_ICAOAdd(uint8_t* pBuff)
{
	uint32_t tempData = 0;
	for (int i = 20 ; i >= 0 ; i -= 4)
	{
		tempData |= (ascii_to_hex(*pBuff) << i);
		pBuff++;
	}
	return tempData;
}

/******************************************************************************************************************************************************************************
 * @fn					- ADSB_Get_Instant_TC
 *
 * @brief				- This function returns the Type Code of the Message that is in the actual index of the ADSB Ring Buffer,
 * 						  and then pass to the index of next section of the frame.
 *
 * @Note				- none
 *
 ******************************************************************************************************************************************************************************/
uint8_t ADSB_Get_Instant_TC(uint8_t* pBuff)
{
	uint8_t tempData = (ascii_to_hex(*pBuff)) << 4;
	pBuff++;
	tempData |=  ascii_to_hex(*pBuff);
	tempData = tempData >> 3;
	return tempData;
}

/******************************************************************************************************************************************************************************
 * @fn					- ADSB_Get_Instant_TC
 *
 * @brief				- This function returns the Message that is in the actual index of the ADSB Ring Buffer,
 * 						  and then pass to the index of next section of the frame.
 *
 * @Note				- none
 *
 ******************************************************************************************************************************************************************************/
uint64_t ADSB_Get_Instant_ME(uint8_t* pBuff)
{
	uint64_t tempData = 0;
	for (int i = 52 ; i >= 0 ; i -= 4)
	{
		tempData |= ((uint64_t)(ascii_to_hex(*pBuff)) << i);
		pBuff++;
	}
	return tempData;
}

/******************************************************************************************************************************************************************************
 * @fn					- ADSB_Get_Instant_PI
 *
 * @brief				- This function returns the Parity that is in the actual index of the ADSB Ring Buffer,
 * 						  and then pass to the index.
 *
 * @Note				- none
 *
 ******************************************************************************************************************************************************************************/
uint32_t ADSB_Get_Instant_PI(uint8_t* pBuff)
{
	uint32_t tempData = 0;
	for (int i = 20 ; i >= 0 ; i -= 4)
	{
		tempData |= (ascii_to_hex(*pBuff) << i);
		pBuff++;
	}
	return tempData;
}

/******************************************************************************************************************************************************************************
 * @fn					- ADSB_Read_HalfBuffer
 *
 * @brief				- This function Move around the ADSB Ring Buffer searching for valid Frames, once it finds one it decodes it and separate in their principals sections
 * 						  and storing the Frame in their respective Downlink Format Ring Buffer
 *
 * @Note				- none
 *
 ******************************************************************************************************************************************************************************/
void ADSB_Read_HalfBuffer(ADSB_RGBuffer_t * pRingBuff, uint32_t timeStamp)
{
	ADSB_FrameStruct tempFrame = {0};

	tempFrame.Status =  ADSB_FindValidFrame(pRingBuff);

	if (tempFrame.Status == VALID_FRAME)
	{
		tempFrame = ADSB_DecodeFrame(pRingBuff, timeStamp);

		if(tempFrame.DownlinkFormat == 18) {ADSB_RingBuffer_PushFrame(&RGBuff_DF_18, tempFrame);}
		if(tempFrame.DownlinkFormat == 17) {ADSB_RingBuffer_PushFrame(&RGBuff_DF_17, tempFrame);}
	}
}

/******************************************************************************************************************************************************************************
 * @fn                    - ADSB_DecodeFrame
 *
 * @brief                - Decodes a complete ADS-B frame from the ring buffer and extracts all relevant message fields
 *
 * @param[in] pRingBuff    - Pointer to the ADS-B raw data ring buffer containing the received frame bytes
 * @param[in] timeStamp    - Timestamp associated with the reception of the ADS-B frame
 *
 * @return                - ADSB_FrameStruct populated with decoded ADS-B frame information
 *
 * @Note                - This function sequentially parses the ADS-B frame fields (DF, CA, ICAO Address, Type Code,
 *                          Message Extension, and Parity) by advancing through the ring buffer.
 *                          For position-related Type Codes (TC 5–8, 9–18, 20–22), CPR data is extracted and stored
 *                          into the corresponding Even or Odd CPR ring buffer for later global position decoding.
 *
 *****************************************************************************************************************************************************************************/
ADSB_FrameStruct ADSB_DecodeFrame(ADSB_RGBuffer_t * pRingBuff, uint32_t timeStamp)
{
	ADSB_FrameStruct tempFrame = {0};

	tempFrame.DownlinkFormat = ADSB_Get_Instant_DF(&pRingBuff->buffer[pRingBuff->index]);
	ADSB_MovFwd(pRingBuff);
	tempFrame.Capability = ADSB_Get_Instant_CA(&pRingBuff->buffer[pRingBuff->index]);
	ADSB_MovFwd(pRingBuff);
	tempFrame.ICAOAddress = ADSB_Get_Instant_ICAOAdd(&pRingBuff->buffer[pRingBuff->index]);
	for(int i = 0; i < 6 ; i++) ADSB_MovFwd(pRingBuff);
	tempFrame.TypeCode = ADSB_Get_Instant_TC(&pRingBuff->buffer[pRingBuff->index]);
	tempFrame.Message = ADSB_Get_Instant_ME(&pRingBuff->buffer[pRingBuff->index]);
	for(int i = 0; i < 14 ; i++) ADSB_MovFwd(pRingBuff);
	tempFrame.Parity = ADSB_Get_Instant_PI(&pRingBuff->buffer[pRingBuff->index]);
	for(int i = 0; i < 6 ; i++) ADSB_MovFwd(pRingBuff);
	tempFrame.Status = VALID_FRAME;

	if ((tempFrame.TypeCode >= 20 && tempFrame.TypeCode <= 22) || (tempFrame.TypeCode >= 9 && tempFrame.TypeCode <= 18) || (tempFrame.TypeCode >= 5 && tempFrame.TypeCode <= 8))
	{
		ADSB_LocationByICAO tempCPR = {0};

		tempCPR.ICAOAddress = tempFrame.ICAOAddress;
		tempCPR.TimeStamp = timeStamp;
		tempCPR.EvenOdd = ADSB_ParseMessage_GetEvenOddF(tempFrame.Message);
		tempCPR.CPRlat = ADSB_ParseMessage_GetLAT(tempFrame.Message);
		tempCPR.CPRlon = ADSB_ParseMessage_GetLON(tempFrame.Message);
		tempCPR.Status = FULL;

		if(tempCPR.EvenOdd) ADSB_RingBuffer_PushCPRFrame(&RGBuff_CPR_ODD, tempCPR);
		if(!(tempCPR.EvenOdd)) ADSB_RingBuffer_PushCPRFrame(&RGBuff_CPR_EVEN, tempCPR);
	}
	return tempFrame;
}


/******************************************************************************************************************************************************************************
 * @fn                    - ADSB_CPR_Look4Odd
 *
 * @brief                - Searches the Odd CPR ring buffer for a stored CPR frame matching a given ICAO address
 *
 * @param[in] ICAOadd    - ICAO 24-bit aircraft address used to identify the CPR frame
 *
 * @return                - ADSB_LocationByICAO structure containing the matching Odd CPR data, or an empty structure
 *                          if no matching entry is found
 *
 * @Note                - This function performs a linear search through the Odd CPR buffer.
 *                          The returned CPR data is intended to be paired with a corresponding Even CPR frame
 *                          for global position decoding.
 *
 *****************************************************************************************************************************************************************************/
ADSB_LocationByICAO ADSB_CPR_Look4Odd(uint32_t ICAOadd)
{
	ADSB_LocationByICAO retVal = {0};
	for(int i = 0; i < CPR_BUFF_SZ ; i++)
	{
		if (RGBuff_CPR_ODD.buffer[i].ICAOAddress == ICAOadd)
		{
			retVal.ICAOAddress = RGBuff_CPR_ODD.buffer[i].ICAOAddress;
			retVal.EvenOdd = RGBuff_CPR_ODD.buffer[i].EvenOdd;
			retVal.TimeStamp = RGBuff_CPR_ODD.buffer[i].TimeStamp;
			retVal.Status = RGBuff_CPR_ODD.buffer[i].Status;
			retVal.CPRlat = RGBuff_CPR_ODD.buffer[i].CPRlat;
			retVal.CPRlon = RGBuff_CPR_ODD.buffer[i].CPRlon;
		}
	}
	return retVal;
}
