/******************************************************************************************************************************************************************************
 * @fn                    - Binary2Gray
 *
 * @brief                - Converts a binary value to its corresponding Gray code representation
 *
 * @param[in] Binary        - Binary input value to be converted
 *
 * @return                - Gray code equivalent of the input binary value
 *
 * @Note                - Gray code is commonly used in digital encoding to minimize bit transitions
 *
 *****************************************************************************************************************************************************************************/
uint16_t Binary2Gray(uint16_t Binary)
{
	return Binary ^ (Binary >> 1);
}


/******************************************************************************************************************************************************************************
 * @fn                    - ADSB_Power
 *
 * @brief                - Computes the power of a floating-point base raised to an integer exponent
 *
 * @param[in] x            - Base value
 * @param[in] power        - Exponent value (positive integer)
 *
 * @return                - Result of x raised to the specified power
 *
 * @Note                - This function performs iterative multiplication and does not handle negative exponents
 *
 *****************************************************************************************************************************************************************************/
double ADSB_Power(double x, int power)
{
	double original_x = x;
	for(int i = 1; i < power; i++)
	{
		x = x*original_x;
	}
	return x;
}

/******************************************************************************************************************************************************************************
 * @fn                    - ADSB_Init_LUT_NL
 *
 * @brief                 - Initializes the NL (Number of Longitude Zones) Lookup Table used for CPR position decoding
 *
 * @param[in] none        - none
 *
 * @return                - none
 *
 * @Note                  - The NL lookup table maps latitude degrees (0 to 89) to the corresponding number of longitude
 *                          zones as defined by the ICAO CPR algorithm. This table is required for both airborne and
 *                          ground position global CPR decoding.
 *
 *****************************************************************************************************************************************************************************/
void ADSB_Init_LUT_NL(void)
{
	long double x = 0;
	for(int i = 0; i < 90; i++)
	{
		ADSAB_LUT_NL[i] = -((18*ADSB_Power((x-1.5), 2))+(12*(x-1.5)))/(1550+9*(x-1.5))+60;
		x++;
	}
}

