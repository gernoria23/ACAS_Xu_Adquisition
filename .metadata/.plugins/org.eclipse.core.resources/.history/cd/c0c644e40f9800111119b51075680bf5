/******************************************************************************************************************************************************************************
 * @fn					- ADSB_GetFlagStatus
 *
 * @brief				- This function returns the ADSB Status of the ADSB Ring Buffer.
 *
 * @Note				- none
 *
 ******************************************************************************************************************************************************************************/

ADSB_StatusTypedef ADSB_GetFlagStatus(void)
{
	if(Buff2Parse_FstHalf_flg == EMPTY && Buff2Parse_SndHalf_flg == EMPTY) return ADSB_EMPTY;
	if(Buff2Parse_FstHalf_flg == EMPTY && Buff2Parse_SndHalf_flg == FULL) return ADSB_HEMPTY;
	if(Buff2Parse_FstHalf_flg == FULL && Buff2Parse_SndHalf_flg == EMPTY) return ADSB_HFULL;
	if(Buff2Parse_FstHalf_flg == FULL && Buff2Parse_SndHalf_flg == FULL) {return ADSB_FULL;}else return ADSB_ERROR;
}

/******************************************************************************************************************************************************************************
 * @fn					- KeepLooking
 *
 * @brief				- This function checks if the ADSB Ring Buffer has been completely readed.
 * 						  returns 0 if is completely readed and 1 if is something pending to read
 *
 * @Note				- none
 *
 ******************************************************************************************************************************************************************************/

uint8_t ADSB_KeepLooking(void)
{
	if(ADSB_GetFlagStatus() != ADSB_EMPTY && ADSB_GetFlagStatus() != ADSB_ERROR){return 1;}else return 0;
}

