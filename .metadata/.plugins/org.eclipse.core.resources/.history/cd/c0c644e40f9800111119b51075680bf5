/******************************************************************************************************************************************************************************
 * @fn                    - ascii_to_hex
 *
 * @brief                - Converts an ASCII character representing a hexadecimal digit into its numerical value
 *
 * @param[in] byte        - ASCII character ('0'–'9', 'A'–'F', or 'a'–'f')
 *
 * @return                - Hexadecimal value (0 to 15) if valid, or 0xFF if the character is invalid
 *
 * @Note                - Intended for parsing hexadecimal input from text-based sources
 *
 *****************************************************************************************************************************************************************************/
uint8_t ascii_to_hex(uint8_t byte)
{
    if (byte >= '0' && byte <= '9'){return byte - '0';}
    else if (byte >= 'A' && byte <= 'F'){return byte - 'A' + 10;}
    else if (byte >= 'a' && byte <= 'f'){return byte - 'a' + 10;}
    else{return 0xFF;}
}

/******************************************************************************************************************************************************************************
 * @fn                    - hex_to_ascii
 *
 * @brief                - Converts a numerical hexadecimal value into its corresponding ASCII character
 *
 * @param[in] value       - Hexadecimal numerical value (0 to 15)
 *
 * @return                - ASCII character ('0'–'9' or 'A'–'F') if valid, or 0xFF if the value is invalid
 *
 * @Note                - Intended for formatting hexadecimal values into text-based outputs (uppercase)
 *
 *****************************************************************************************************************************************************************************/
uint8_t hex_to_ascii(uint8_t value)
{
    if (value <= 9){return value + '0';}
    else if (value >= 10 && value <= 15){return value - 10 + 'A';}
    else{return 0xFF;}
}

