/******************************************************************************************************************************************************************************
 * @fn					- ADSB_Read_DownlinkFormatBuffer
 *
 * @brief				- This function Reads the Downlink Format Ring Buffer selected and Parse the Message section from the Frames inside.
 *
 * @param[downlinkFormatSelected]		- Downlink Format Value that choose wich Downlink Format Ring Buffer will be readed.
 * @param[ringBuffer2process]			- Ring Buffer were the parse information goes.
 *
 * @Note				- none
 *
 ******************************************************************************************************************************************************************************/

ADSB_FrameStruct ADSB_Read_DownlinkFormatBuffer(uint16_t downlinkFormatSelected)
{
	ADSB_FrameStruct tempFrame = {0};

	if (downlinkFormatSelected == 17)
	{
		tempFrame = ADSB_RingBuffer_PopFrame(&RGBuff_DF_17);
	}
	else if (downlinkFormatSelected == 18)
	{
		tempFrame = ADSB_RingBuffer_PopFrame(&RGBuff_DF_18);
	}
	else
	{
		tempFrame.Status = EMPTY_FRAME;
	}
	return tempFrame;
}


