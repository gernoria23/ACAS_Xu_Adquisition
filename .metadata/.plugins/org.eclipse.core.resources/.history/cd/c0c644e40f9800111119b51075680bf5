/******************************************************************************************************************************************************************************
 * @fn					- ADSB_MovFwd
 *
 * @brief				- This function increment the index at the same time that check
 * 						  if some Half of the ADSB Ring Buffer is completely readed.
 *
 * @param[pRingBuff]	- Select the Ring Buffer by the Downlink Format Selected.
 *
 * @Note				- none
 *
 ******************************************************************************************************************************************************************************/

void ADSB_MovFwd(ADSB_RGBuffer_t * pRingBuff)
{
	pRingBuff->index++;

	if (pRingBuff->index == (RX_BUFF_SZ/2))
	{
		ADSB_RingBuff_FlagUnSet(ADSB_RGBUFF_FST_HALF_CALLBACK);
	}
	if (pRingBuff->index == (RX_BUFF_SZ))
	{
		pRingBuff->index = 0;
		ADSB_RingBuff_FlagUnSet(ADSB_RGBUFF_SND_HALF_CALLBACK);
	}

}

/******************************************************************************************************************************************************************************
 * @fn					- ADSB_validateDF
 *
 * @brief				- This function returns 1 or 0, depending if the Downlink Format is in the array of Valid DFs declared by user.
 *
 * @param[none]			- none
 *
 * @Note				- none
 *
 * ****************************************************************************************************************************************************************************/

uint8_t ADSB_validateDF(uint16_t DownlinkFormat)
{
	for (uint32_t i = 0; i < sizeof(ADSB_ValidDFs) / sizeof(ADSB_ValidDFs[0]); i++ )
	{
		if(DownlinkFormat == ADSB_ValidDFs[i]) return 1;
	}
	return 0;
}

/******************************************************************************************************************************************************************************
 * @fn					- Ring_Buffer_Push
 *
 * @brief				- This function push a new byte into the Ring Buffer Selected
 *
 * @param[*RingBuffer]	- Pointer to the Ring Buffer Handler Selected
 * @param[byte]			- byte to add to the array of the Ring buffer
 *
 * @Note				- none
 *
 * ****************************************************************************************************************************************************************************/

void ADSB_RingBuffer_Push(ADSB_RGBuffer_t *RingBuffer, uint8_t byte)
{
	RingBuffer->buffer[RingBuffer->head] = byte;
	RingBuffer->head= (RingBuffer->head + 1) % RingBuffer->capacity;
	RingBuffer->count ++;
	if(RingBuffer->head == RingBuffer->tail)
	{
		RingBuffer->tail = (RingBuffer->tail + 1) % RingBuffer->capacity;
	}
}

/******************************************************************************************************************************************************************************
 * @fn					- ADSB_RingBuffer_Pop
 *
 * @brief				- This function pop and return the oldest byte in the Ring Buffer
 *
 * @param[*RingBuffer]	- Pointer to the Ring Buffer Handler Selected
 *
 * @Note				- none
 *
 * ****************************************************************************************************************************************************************************/

uint8_t ADSB_RingBuffer_Pop(ADSB_RGBuffer_t *RingBuffer)
{
	uint8_t tempByte = 0;
	if(RingBuffer->head == RingBuffer->tail)
		{
			return tempByte;
		}
	tempByte = RingBuffer->buffer[RingBuffer->tail];
	RingBuffer->tail = (RingBuffer->tail + 1) % RingBuffer->capacity;
	return tempByte;
}

/******************************************************************************************************************************************************************************
 * @fn					- ADSB_RingBuffer_PushFrame
 *
 * @brief				- This function push a new frame into the Downlink Format Ring Buffer Selected
 *
 * @param[*RingBuffer]	- Pointer to the Downlink Format Ring Buffer Handler
 * @param[Frame]		- Frame to add to the array of the Downlink Format Ring buffer
 *
 * @Note				- none
 *
 * ****************************************************************************************************************************************************************************/

void ADSB_RingBuffer_PushFrame(Frame_RGBuffer_t *pRingBuffer, ADSB_FrameStruct Frame)
{
	pRingBuffer->buffer[pRingBuffer->head] = Frame;
	pRingBuffer->head= (pRingBuffer->head + 1) % pRingBuffer->capacity;
	pRingBuffer->count ++;
	if(pRingBuffer->head == pRingBuffer->tail)
	{
		pRingBuffer->tail = (pRingBuffer->tail + 1) % pRingBuffer->capacity;
	}

}

