/******************************************************************************************************************************************************************************
 * @fn                    - ADSB_ParseMessage_GndPos_GetTRK
 *
 * @brief                - Extracts and returns the Ground Track Angle from an ADS-B Ground Position Message
 *
 * @param[in] ME            - Message Extension field (56 bits) of the ADS-B Ground Position message
 *
 * @return                - Ground track angle value relative to true north
 *
 * @Note                - Returned value is meaningful only if Track Status bit is set
 *
 *****************************************************************************************************************************************************************************/
uint8_t ADSB_ParseMessage_GndPos_GetTRK(uint64_t ME)
{
	uint8_t TRKStat = ADSB_ParseMessage_GndPos_GetStatTRK(ME);
	if(TRKStat == 0) return 0;

	uint16_t TRK = (ME >> GndPos[GND_POS_TRK_INDEX][SHIFT_INDEX]) & GndPos[GND_POS_TRK_INDEX][MASK_INDEX];

	TRK = (TRK*360)/128;

	uint8_t retVal = TRK;

	return retVal;
}

