/******************************************************************************************************************************************************************************
 * @fn                    - ADSB_ParseMessage_AirPos_GetALT_Bar
 *
 * @brief                - Extracts and returns the Barometric Altitude from an ADS-B Airborne Position Message
 *
 * @param[in] ME            - Message Extension field (56 bits) of the ADS-B Airborne Position message
 *
 * @return                - Encoded barometric altitude value (typically referenced to 1013.25 hPa)
 *
 * @Note                - Altitude decoding follows Gillham / Q-bit encoding rules depending on message
 *
 *****************************************************************************************************************************************************************************/
uint16_t ADSB_ParseMessage_AirPos_GetALT_Bar(uint64_t ME)
{
	uint16_t retVal = (ME >> AirPos[AIR_POS_ALT_INDEX][SHIFT_INDEX]) & AirPos[AIR_POS_ALT_INDEX][MASK_INDEX];
	uint8_t Qbit = ((retVal >> 5) & 0x01);
	retVal = ((retVal >> (5 + 1)) << 5)|(retVal & ((1 << 5)-1));

	if(Qbit == 1) retVal = (retVal*25)-1000;
	if(Qbit == 0) retVal = Binary2Gray(retVal);
	return retVal;
}

