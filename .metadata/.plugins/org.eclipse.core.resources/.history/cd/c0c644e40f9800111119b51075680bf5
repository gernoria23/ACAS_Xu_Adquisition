/******************************************************************************************************************************************************************************************************************************************************************************
 * @fn					- ADSB_RingBuffer_Init
 *
 * @brief				- This function Initialize the Ring Buffer for ADSB data reception.
 *
 * @param[*RingBuffer]	- Pointer to the Ring Buffer Handler
 * @param[*Storage]		- Pointer to the Start Address of the Array asigned to this Ring Buffer
 * @param[capacity]		- The size of the Storage Array
 *
 * @Note				- none
 *
 * ****************************************************************************************************************************************************************************/

void ADSB_RingBuffer_Init(ADSB_RGBuffer_t* RingBuffer, uint8_t *Storage, uint32_t capacity)
{
	RingBuffer->buffer   = Storage;
	RingBuffer->capacity = capacity;
	RingBuffer->head  = 0;
	RingBuffer->tail  = 0;
	RingBuffer->count = 0;
	RingBuffer->index = 0;

}

