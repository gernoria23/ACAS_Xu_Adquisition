/******************************************************************************************************************************************************************************
 * @fn                    - ADSB_floor
 *
 * @brief                - Computes the mathematical floor of a floating-point value
 *
 * @param[in] x            - Input floating-point value
 *
 * @return                - Largest integer value less than or equal to x
 *
 * @Note                - This function explicitly handles negative values to ensure correct floor behavior,
 *                          unlike a simple cast to int which truncates toward zero
 *
 *****************************************************************************************************************************************************************************/
int ADSB_floor(double x)
{
	int y = (int)x;
	int retval = (x < 0 && x != y)? y-1: y;
	return retval;
}


/******************************************************************************************************************************************************************************
 * @fn                    - ADSB_mod
 *
 * @brief                - Computes the mathematical modulus of two integers
 *
 * @param[in] x            - Dividend value
 * @param[in] y            - Divisor value
 *
 * @return                - Result of x modulo y
 *
 * @Note                - Modulus operation is implemented using floor division to ensure proper behavior
 *                          when handling negative values, as required by the CPR decoding algorithm
 *
 *****************************************************************************************************************************************************************************/
int ADSB_mod(int x, int y)
{
	int retVal = x-(y * ADSB_floor(x/y));
	return retVal;
}


/******************************************************************************************************************************************************************************
 * @fn                    - ADSB_NL
 *
 * @brief                - Returns the Number of Longitude Zones (NL) for a given latitude
 *
 * @param[in] lat        - Latitude value in degrees
 *
 * @return                - Number of longitude zones corresponding to the input latitude
 *
 * @Note                - This function uses the precomputed NL lookup table and applies symmetry
 *                          for positive and negative latitudes as defined by the CPR specification
 *
 *****************************************************************************************************************************************************************************/
int ADSB_NL(int lat)
{
	if(lat >= 0)
	{
		return ADSB_floor(ADSAB_LUT_NL[lat]);
	}else
	{
		lat = lat*(-1);
		return ADSB_floor(ADSAB_LUT_NL[lat]);
	}
}


/******************************************************************************************************************************************************************************
 * @fn                    - ADSB_max
 *
 * @brief                - Returns the maximum of two integer values
 *
 * @param[in] a            - First integer value
 * @param[in] b            - Second integer value
 *
 * @return                - The greater of the two input values
 *
 * @Note                - If both values are equal, the function returns either value
 *
 *****************************************************************************************************************************************************************************/
int ADSB_max(int a, int b)
{
	if(a > b) return a;
	if(b > a) return b;
	return a;
}

/******************************************************************************************************************************************************************************
 * @fn                   - ADSB_CPR_DecodeLocation_GlobalUnambiguousPosMethod
 *
 * @brief                - Decodes the global unambiguous latitude and longitude using the CPR Even/Odd position method
 *
 * @param[in] EvenLat    - Normalized CPR latitude value from the Even frame
 * @param[in] EvenLon    - Normalized CPR longitude value from the Even frame
 * @param[in] OddLat     - Normalized CPR latitude value from the Odd frame
 * @param[in] OddLon     - Normalized CPR longitude value from the Odd frame
 * @param[in] RecentFlag - Indicates which CPR frame is the most recent
 *                          (0 = Even frame is more recent, 1 = Odd frame is more recent)
 * @param[out] pBuff     - Pointer to output buffer where decoded latitude and longitude are stored
 *                          [pBuff[0] = Latitude, pBuff[1] = Longitude]
 *
 * @return               - none
 *
 * @Note                 - This function implements the ICAO global CPR position decoding algorithm using paired
 *                         Even and Odd frames. A valid position is computed only if both frames resolve to
 *                         the same NL (Number of Longitude Zones) value. The resulting latitude and longitude
 *                         are returned in degrees, referenced to the WGS-84 coordinate system.
 *
 *****************************************************************************************************************************************************************************/
void ADSB_CPR_DecodeLocation_GlobalUnambiguousPosMethod(double EvenLat, double EvenLon, double OddLat, double OddLon, uint8_t RecentFlag, double *pBuff)
{
	int latIndex = ADSB_floor((59.0 * EvenLat) - (60.0 * OddLat) + 0.5);
	double latEven = DLAT_EVEN * (ADSB_mod(latIndex,60) + EvenLat);
	double latOdd = DLAT_ODD * (ADSB_mod(latIndex, 59) + OddLat);

	if(latEven >= 270) latEven -= 360.0;
	if(latOdd >= 270) latOdd -= 360.0;

	int NL_lateven = ADSB_NL(ADSB_floor(latEven));
	int NL_latodd  = ADSB_NL(ADSB_floor(latOdd ));

	if(NL_lateven == NL_latodd)
	{
		int m = ADSB_floor(EvenLon * (NL_lateven-1.0) - OddLon * NL_lateven + 0.5);

		if(RecentFlag == 0)
		{
			int n_even = ADSB_max(NL_lateven, 1);
			double lonEven = (360.0/n_even)*(ADSB_mod(m, n_even) + EvenLon);
			if(lonEven >= 180) lonEven -= 360;

			*pBuff = latEven;
			pBuff++;
			*pBuff = lonEven;
		}
		if(RecentFlag == 1)
		{
			int n_odd = ADSB_max(NL_latodd, 1);
			double lonOdd = (360.0/n_odd)*(ADSB_mod(m, n_odd) + OddLon);
			if(lonOdd >= 180) lonOdd -= 360;

			*pBuff = latOdd;
			pBuff++;
			*pBuff = lonOdd;
		}
	}
}

/******************************************************************************************************************************************************************************
 * @fn                    - ADSB_CPR_DecodeLocationByICAO
 *
 * @brief                - Decodes the global aircraft position using paired CPR frames associated with a specific ICAO address
 *
 * @param[in] CPR1        - First CPR location frame (Even or Odd) associated with the aircraft ICAO address
 * @param[in] CPR2        - Second CPR location frame (Even or Odd) associated with the aircraft ICAO address
 * @param[out] pLocationBuff
 *                        - Pointer to output buffer where the decoded latitude and longitude are stored
 *                          [pLocationBuff[0] = Latitude, pLocationBuff[1] = Longitude]
 *
 * @return                - Status of the decoding operation
 *                          (0 = Invalid or incomplete CPR data, 1 = Successful position decode)
 *
 * @Note                - This function normalizes the raw CPR latitude and longitude values, determines which
 *                          frames correspond to Even and Odd formats, and selects the most recent frame
 *                          based on timestamp information. Global unambiguous position decoding is then
 *                          performed using the ICAO CPR Even/Odd algorithm.
 *
 *****************************************************************************************************************************************************************************/
uint8_t ADSB_CPR_DecodeLocationByICAO(ADSB_LocationByICAO CPR1, ADSB_LocationByICAO CPR2, double *pLocationBuff)
{
	if(CPR1.Status == EMPTY || CPR2.Status == EMPTY) return 0;
	double CPR_EvenLat = 0;
	double CPR_EvenLon = 0;
	double CPR_OddLat =  0;
	double CPR_OddLon =  0;
	if(CPR1.EvenOdd == 0)
	{
		CPR_EvenLat =(double) CPR1.CPRlat/ 131072.0;
		CPR_EvenLon =(double) CPR1.CPRlon/ 131072.0;
		CPR_OddLat = (double) CPR2.CPRlat/ 131072.0;
		CPR_OddLon = (double) CPR2.CPRlon/ 131072.0;
	}else
	{
		CPR_OddLat = (double) CPR1.CPRlat/ 131072.0;
		CPR_OddLon = (double) CPR1.CPRlon/ 131072.0;
		CPR_EvenLat =(double) CPR2.CPRlat/ 131072.0;
		CPR_EvenLon =(double) CPR2.CPRlon/ 131072.0;
	}
	if(CPR1.TimeStamp > CPR2.TimeStamp)
	{
		ADSB_CPR_DecodeLocation_GlobalUnambiguousPosMethod(CPR_EvenLat, CPR_EvenLon, CPR_OddLat, CPR_OddLon, CPR2.EvenOdd, pLocationBuff);
	}else
	{
		ADSB_CPR_DecodeLocation_GlobalUnambiguousPosMethod(CPR_EvenLat, CPR_EvenLon, CPR_OddLat, CPR_OddLon, CPR1.EvenOdd, pLocationBuff);
	}
	return 1;
}

/******************************************************************************************************************************************************************************
 * @fn                    - ADSB_GetCPR_Flag
 *
 * @brief                - Determines whether an ADS-B message contains CPR position information based on its Type Code
 *
 * @param[in] ME            - Message Extension field (56 bits) of the ADS-B message
 *
 * @return                - Frame status indicating presence of CPR data
 *                          (FULL = Message contains CPR position information,
 *                           EMPTY = Message does not contain CPR data)
 *
 * @Note                - CPR data is present only for position-related Type Codes:
 *                          Ground Position (TC 5–8), Airborne Position (TC 9–18),
 *                          and Airborne Position (GNSS height) (TC 20–22).
 *
 *****************************************************************************************************************************************************************************/
ADSB_FrameStatus ADSB_GetCPR_Flag(uint64_t ME)
{
	uint8_t TC = (ME >> PARSING_TC_SHIFT) & PARSING_TC_MASK;
	if ((TC >= 20 && TC <= 22) || (TC >= 9 && TC <= 18) || (TC >= 5 && TC <= 8)) return FULL;
	return EMPTY;
}

/******************************************************************************************************************************************************************************
 * @fn                   - ADSB_ParseMessage_AirId_GetCategory
 *
 * @brief                - Extracts and returns the Aircraft Category from an Airborne Identification ADS-B Message
 *
 * @param[in] ME         - Message Extension field (56 bits) of the ADS-B Airborne Identification message
 *
 * @return               - Aircraft Category value as defined by ICAO (derived from Type Code and Category Subfield)
 *
 * @Note                 - The returned category is valid only for Airborne Identification Type Codes (TC = 1 to 4)
 *
 *****************************************************************************************************************************************************************************/
uint8_t ADSB_ParseMessage_AirId_GetCategory(uint64_t ME)
{
	uint8_t retVal = (ME >> AirId[AIR_ID_CATEGORY_INDEX][SHIFT_INDEX]) & AirId[AIR_ID_CATEGORY_INDEX][MASK_INDEX];
	return retVal;
}

/******************************************************************************************************************************************************************************
 * @fn                   - ADSB_ParseMessage_AirId_GetCallsign
 *
 * @brief                - Decodes and extracts the 8-character aircraft callsign from an Airborne Identification ADS-B Message
 *
 * @param[in] ME         - Message Extension field (56 bits) of the ADS-B Airborne Identification message
 * @param[out] pBuff     - Pointer to user buffer where the decoded callsign string will be stored (ASCII, null-terminated)
 *
 * @return               - none
 *
 * @Note                 - Callsign is encoded as 8 six-bit characters according to ICAO Annex 10
 *
 *****************************************************************************************************************************************************************************/
void ADSB_ParseMessage_AirId_GetCallsign(uint64_t ME, uint8_t * pBuff)
{
	uint8_t temp = 0;
	for (int i = AIR_ID_FIRST_CALLSIGN_INDEX ; i < AIR_ID_LAST_CALLSIGN_INDEX; i++ )
	{
		temp = (ME >> AirId[i][SHIFT_INDEX]) & AirId[i][MASK_INDEX];
		*pBuff = CallsignLookUpTable[temp];
		pBuff++;
	}
}

/******************************************************************************************************************************************************************************
 * @fn                   - ADSB_ParseMessage_AirId_GetWakeVortex
 *
 * @brief                - Determines and returns the aircraft Wake Vortex Category based on Type Code and Identification Message
 *
 * @param[in] TC         - ADS-B Type Code of the received message
 * @param[in] ME         - Message Extension field (56 bits) of the ADS-B Airborne Identification message
 *
 * @return               - Wake Vortex Category (e.g., Light, Medium, Heavy, Super)
 *
 * @Note                 - Wake vortex classification is inferred from Aircraft Category and applicable only for TC = 1 to 4
 *
 *****************************************************************************************************************************************************************************/
uint8_t ADSB_ParseMessage_AirId_GetWakeVortex(uint8_t TC, uint64_t ME)
{
	uint8_t category = ADSB_ParseMessage_AirId_GetCategory(ME);
	if (TC == 1) return 0;
	if (category == 0) return 1;
	if (TC ==2)
	{
		switch(category)
		{
		case 1:
			return 2;
		case 2:
			return 3;
		case 3:
			return 4;
		default:
			return 0;
		}
	}else if(TC == 3)
	{
		switch(category)
		{
		case 1:
			return 6;
		case 2:
			return 7;
		case 3:
			return 8;
		case 4:
			return 9;
		case 6:
			return 11;
		case 7:
			return 12;
		default:
			return 0;
		}
	}else if(TC == 4)
	{
		switch(category)
		{
		case 1:
			return 13;
		case 2:
			return 14;
		case 3:
			return 15;
		case 4:
			return 16;
		case 5:
			return 17;
		case 6:
			return 18;
		case 7:
			return 19;
		default:
			return 0;
		}
	}else return 0;
}

/******************************************************************************************************************************************************************************
 * @fn                    - ADSB_ParseMessage_GndPos_GetGndSpeed
 *
 * @brief                - Extracts and returns the Ground Speed from an ADS-B Ground Position Message
 *
 * @param[in] ME            - Message Extension field (56 bits) of the ADS-B Ground Position message
 *
 * @return                - Ground speed value as encoded in the message (typically in knots after decoding)
 *
 * @Note                - Valid only for Ground Position Type Codes (TC = 5 to 8)
 *
 *****************************************************************************************************************************************************************************/
uint8_t ADSB_ParseMessage_GndPos_GetGndSpeed(uint64_t ME)
{
	uint16_t Speed = ((ME >> GndPos[GND_POS_MOV_INDEX][SHIFT_INDEX]) & GndPos[GND_POS_MOV_INDEX][MASK_INDEX]);
	uint16_t StepSize = 0;
	uint16_t retVal = 0;
	if(Speed == 0) return 0;
	if(Speed == 1) return 1;
	if(Speed >= 2 && Speed <= 8)
	{
		StepSize = 0.125;
		Speed --;
		Speed = Speed * StepSize;
		retVal = Speed;

	}else if(Speed >= 9 && Speed <= 12)
	{
		StepSize = 0.25;
		Speed = Speed - 9;
		Speed = Speed * StepSize;
		retVal = 1;
		retVal = retVal + Speed;

	}else if(Speed >= 13 && Speed <= 38)
	{
		StepSize = 0.5;
		Speed = Speed - 13;
		Speed = Speed * StepSize;
		retVal = 2;
		retVal = retVal + Speed;

	}else if(Speed >= 39 && Speed <= 93)
	{
		StepSize = 1;
		Speed = Speed - 39;
		Speed = Speed * StepSize;
		retVal = 15;
		retVal = retVal + Speed;

	}else if(Speed >= 94 && Speed <= 108)
	{
		StepSize = 2;
		Speed = Speed - 94;
		Speed = Speed * StepSize;
		retVal = 70;
		retVal = retVal + Speed;

	}else if(Speed >= 109 && Speed <= 123)
	{
		StepSize = 5;
		Speed = Speed - 109;
		Speed = Speed * StepSize;
		retVal = 70;
		retVal = retVal + Speed;

	}else if(Speed == 124)
	{
		retVal = 175;
	}else
	{
		return 0xFF;
	}

	return retVal;
}

